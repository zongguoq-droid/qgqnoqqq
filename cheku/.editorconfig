# ================================================================
#  EditorConfig — 统一编辑器行为
#  https://editorconfig.org
#
#  作用: 让不同编辑器/IDE 在本项目中自动采用相同的缩进、编码、换行符,
#        避免"在我机器上格式是对的"这类协作噪音。
#  支持: VS Code / CLion / Vim / Emacs 等主流编辑器 (部分需装插件)
# ================================================================

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# ---- C / C++ 源码: 4 空格缩进 ----
[*.{c,h,cpp,hpp,cc,hh}]
indent_style = space
indent_size = 4
max_line_length = 100

# ---- Makefile: 必须使用 Tab 缩进 (空格会导致 "missing separator" 错误) ----
[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

# ---- Shell 脚本 ----
[*.sh]
indent_style = space
indent_size = 4

# ---- 配置 / 数据 / 文档 ----
[*.{ini,cfg,conf}]
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_style = space
indent_size = 2

[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false   # Markdown 行尾双空格表示换行, 勿裁剪

# ---- Qt ----
[*.{pro,pri}]
indent_style = space
indent_size = 4

[*.ui]
indent_style = space
indent_size = 2
